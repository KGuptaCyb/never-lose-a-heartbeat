# Cloud function URL: https://<project-ref>.supabase.co/functions/v1/pipeline
CLOUD_URL=
# Supabase publishable (public) key
CLOUD_ANON_KEY=
# Shared secret, must match the DEVICE_TOKEN secret set on the function
DEVICE_TOKEN=
MOCK_HOST=127.0.0.1
MOCK_PORT=7100
PIPELINE_DB=/var/lib/pipeline/pipeline.db
# Optional: command for the biosignal-mock service (quote it)
MOCK_CMD="/usr/local/bin/biosignal-mock --mode signal --seed 7 --duration 3600 --port 7100"
